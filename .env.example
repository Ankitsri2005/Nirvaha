# ==============================================================================
# Food Traceability System - Root Environment Configuration Template
# Copy this file to '.env' and populate with your local values.
# ==============================================================================

# --- Application & General ---
APP_NAME=FoodTrace
APP_ENV=development
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-secret-key

# --- Backend API (FastAPI / Node) ---
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (PostgreSQL / SQLite) ---
DATABASE_URL=sqlite:///./food_traceability.db
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/food_traceability

# --- IoT Simulator / MQTT Broker ---
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC_TELEMETRY=foodtrace/telemetry
SIMULATOR_INTERVAL_SECONDS=2

# --- Blockchain / Smart Contract (Phase 4) ---
BLOCKCHAIN_PROVIDER_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_TITLE=FoodTrace Cold-Chain Monitor
